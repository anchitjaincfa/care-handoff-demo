{
  "name": "care-handoff-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-service-worker.mjs",
    "serve:static": "node scripts/serve-static.mjs out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:parser": "vitest run tests/parser",
    "test:infrastructure": "vitest run tests/infrastructure",
    "test:e2e": "playwright test tests/e2e/*.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:privacy": "playwright test tests/e2e/privacy.spec.ts",
    "check:claims": "node scripts/check-claims.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "verify:light": "npm run typecheck && npm run lint && npm run check:claims && npm run check:registry && npm run check:sw-sync && npm run check:storage-names && npm run check:overrides && npm run check:release-contract",
    "verify": "npm run verify:light && npm test && npm run build",
    "test:unit": "vitest run --exclude tests/parser/**",
    "check:sw-sync": "node scripts/check-service-worker-sync.mjs",
    "check:storage-names": "node scripts/check-storage-names.mjs",
    "check:overrides": "node scripts/check-dependency-overrides.mjs",
    "check:release-contract": "node scripts/check-release-contract.mjs && bash scripts/test-smoke-vercel-live.sh",
    "test:journeys": "playwright test tests/e2e/journeys.integration.spec.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "dexie": "4.4.4",
    "fflate": "0.8.3",
    "next": "16.3.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
